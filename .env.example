# Seraaj Platform Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://seraaj:seraaj_dev@localhost/seraaj

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production

# Service Authentication
REQUIRE_SERVICE_AUTH=false

# Service Host Configuration (for Docker)
# Uncomment and modify for container deployments
# APPLICATIONS_SERVICE_HOST=applications-service
# MATCHING_SERVICE_HOST=matching-service
# AUTH_SERVICE_HOST=auth-service
# VOLUNTEERS_SERVICE_HOST=volunteers-service
# OPPORTUNITIES_SERVICE_HOST=opportunities-service
# ORGANIZATIONS_SERVICE_HOST=organizations-service

# Service Port Configuration
# APPLICATIONS_SERVICE_PORT=8001
# MATCHING_SERVICE_PORT=8003
# AUTH_SERVICE_PORT=8004
# VOLUNTEERS_SERVICE_PORT=8005
# OPPORTUNITIES_SERVICE_PORT=8006
# ORGANIZATIONS_SERVICE_PORT=8007
# BFF_SERVICE_PORT=8000

# Service URLs (alternative to host/port)
# AUTH_SERVICE_URL=http://localhost:8004
# APPLICATIONS_SERVICE_URL=http://localhost:8001
# MATCHING_SERVICE_URL=http://localhost:8003
# VOLUNTEERS_SERVICE_URL=http://localhost:8005
# OPPORTUNITIES_SERVICE_URL=http://localhost:8006
# ORGANIZATIONS_SERVICE_URL=http://localhost:8007

# Frontend Configuration
NEXT_PUBLIC_BFF_URL=http://localhost:8000/api

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5.0
HEALTH_CHECK_INTERVAL=30.0

# Circuit Breaker Configuration  
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_EXPECTED_EXCEPTION=httpx.RequestError

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json