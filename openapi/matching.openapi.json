{
  "openapi": "3.1.0",
  "info": {
    "title": "Matching Service",
    "version": "1.0.0"
  },
  "paths": {
    "/quick-match": {
      "post": {
        "summary": "Quick Match",
        "description": "Generate quick match suggestions (top matches)",
        "operationId": "quick_match_quick_match_post",
        "parameters": [
          {
            "name": "volunteer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Volunteer ID to match",
              "title": "Volunteer Id"
            },
            "description": "Volunteer ID to match"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "Number of matches to return",
              "default": 3,
              "title": "Limit"
            },
            "description": "Number of matches to return"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchSuggestion"
                  },
                  "title": "Response Quick Match Quick Match Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/generate": {
      "post": {
        "summary": "Generate Matches",
        "description": "Generate comprehensive match suggestions",
        "operationId": "generate_matches_generate_post",
        "parameters": [
          {
            "name": "volunteer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Volunteer ID to match",
              "title": "Volunteer Id"
            },
            "description": "Volunteer ID to match"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by opportunity category",
              "title": "Category"
            },
            "description": "Filter by opportunity category"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Number of matches to return",
              "default": 10,
              "title": "Limit"
            },
            "description": "Number of matches to return"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchSuggestion"
                  },
                  "title": "Response Generate Matches Generate Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/suggestions/{volunteer_id}": {
      "get": {
        "summary": "Get Suggestions",
        "description": "Get existing suggestions for a volunteer",
        "operationId": "get_suggestions_suggestions__volunteer_id__get",
        "parameters": [
          {
            "name": "volunteer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Volunteer Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MatchSuggestion"
                  },
                  "title": "Response Get Suggestions Suggestions  Volunteer Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Basic health check endpoint",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness Check",
        "description": "Kubernetes liveness probe - is the service running?",
        "operationId": "liveness_check_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness Check",
        "description": "Kubernetes readiness probe - can the service handle requests?",
        "operationId": "readiness_check_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchSuggestion": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "volunteerId": {
            "type": "string",
            "format": "uuid",
            "title": "Volunteerid"
          },
          "opportunityId": {
            "type": "string",
            "format": "uuid",
            "title": "Opportunityid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid",
            "title": "Organizationid"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "reasons": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasons"
          },
          "opportunityTitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opportunitytitle"
          },
          "organizationName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organizationname"
          },
          "status": {
            "$ref": "#/components/schemas/MatchSuggestionStatus"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Generatedat"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "volunteerId",
          "opportunityId",
          "organizationId",
          "score",
          "status",
          "generatedAt"
        ],
        "title": "MatchSuggestion"
      },
      "MatchSuggestionStatus": {
        "type": "string",
        "enum": [
          "active",
          "applied",
          "expired",
          "dismissed"
        ],
        "title": "MatchSuggestionStatus",
        "description": "Current status of the match suggestion"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
