{
  "openapi": "3.1.0",
  "info": {
    "title": "Seraaj BFF API",
    "description": "Backend for Frontend API for the Seraaj volunteer platform",
    "version": "1.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Dependency-aware health check endpoint",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/health/services": {
      "get": {
        "summary": "Services Health Check",
        "description": "Extended health check that includes dependent services",
        "operationId": "services_health_check_api_health_services_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/health/transactions": {
      "get": {
        "summary": "Transaction Health Check",
        "description": "Transaction manager health and statistics",
        "operationId": "transaction_health_check_api_health_transactions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register User",
        "description": "Register a new user account",
        "operationId": "register_user_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login User",
        "description": "Login with email and password",
        "operationId": "login_user_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Refresh Tokens",
        "description": "Refresh access token",
        "operationId": "refresh_tokens_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Current User",
        "description": "Get current user profile",
        "operationId": "get_current_user_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/volunteer/quick-match": {
      "post": {
        "summary": "Get Quick Match",
        "description": "Get quick match suggestions for a volunteer",
        "operationId": "get_quick_match_api_volunteer_quick_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuickMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/volunteer/apply": {
      "post": {
        "summary": "Submit Application",
        "description": "Submit a volunteer application",
        "operationId": "submit_application_api_volunteer_apply_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitApplicationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/volunteer/{volunteer_id}/dashboard": {
      "get": {
        "summary": "Get Volunteer Dashboard",
        "description": "Get volunteer dashboard data",
        "operationId": "get_volunteer_dashboard_api_volunteer__volunteer_id__dashboard_get",
        "parameters": [
          {
            "name": "volunteer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Volunteer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email",
            "description": "User's email address"
          },
          "password": {
            "type": "string",
            "title": "Password",
            "description": "User's password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginUserRequest"
      },
      "QuickMatchRequest": {
        "properties": {
          "volunteerId": {
            "type": "string",
            "title": "Volunteerid",
            "description": "ID of the volunteer requesting matches"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "Maximum number of matches to return",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "volunteerId"
        ],
        "title": "QuickMatchRequest"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refreshToken": {
            "type": "string",
            "title": "Refreshtoken",
            "description": "Valid refresh token"
          }
        },
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "title": "RefreshTokenRequest"
      },
      "RegisterUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email",
            "description": "User's email address"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "description": "User's password (minimum 8 characters)"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "description": "User's full name"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User's role"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name",
          "role"
        ],
        "title": "RegisterUserRequest"
      },
      "SubmitApplicationRequest": {
        "properties": {
          "volunteerId": {
            "type": "string",
            "title": "Volunteerid",
            "description": "ID of the volunteer submitting the application"
          },
          "opportunityId": {
            "type": "string",
            "title": "Opportunityid",
            "description": "ID of the opportunity being applied to"
          },
          "coverLetter": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverletter",
            "description": "Optional cover letter from volunteer"
          }
        },
        "type": "object",
        "required": [
          "volunteerId",
          "opportunityId"
        ],
        "title": "SubmitApplicationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
