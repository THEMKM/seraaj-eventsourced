# Event Store Retention Policy Configuration
# Copy to .env or set as environment variables

# Global retention settings
EVENT_RETENTION_DAYS=90
EVENT_ARCHIVE_LOCATION=data/archives
EVENT_ARCHIVE_COMPRESS=true

# Scheduler settings
RETENTION_SCHEDULER_ENABLED=true
RETENTION_SCHEDULER_FREQUENCY=daily  # daily, weekly, monthly
RETENTION_SCHEDULER_TIME=02:00

# Redis retention
RETENTION_REDIS_ENABLED=true
RETENTION_REDIS_MAX_LENGTH=10000

# Optional notification webhook for retention results
RETENTION_NOTIFICATION_WEBHOOK=https://hooks.slack.com/your/webhook/url

# Service-specific retention overrides
# APPLICATION_RETENTION_DAYS=60
# AUTH_RETENTION_DAYS=180
# MATCH_RETENTION_DAYS=30