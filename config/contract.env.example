# Contract Compliance Testing Configuration
# Copy to .env or set as environment variables

# Contract monitoring
CONTRACT_MONITORING_ENABLED=true
CONTRACT_MONITORING_INTERVAL=30  # minutes between checks
CONTRACT_MONITORING_WEBHOOK=https://hooks.slack.com/your/webhook/url

# Alert settings
CONTRACT_ALERT_DEGRADED=true
CONTRACT_ALERT_FAILURE=true
CONTRACT_FAILURE_THRESHOLD=3  # consecutive failures before critical alert

# Service URLs for testing (development)
BFF_SERVICE_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8004
APPLICATIONS_SERVICE_URL=http://localhost:8001
MATCHING_SERVICE_URL=http://localhost:8003

# Contract testing settings
CONTRACT_TEST_TIMEOUT=30  # seconds
CONTRACT_VALIDATION_ENABLED=true
CONTRACT_ENFORCE_CRITICAL=true  # fail CI on critical contract violations